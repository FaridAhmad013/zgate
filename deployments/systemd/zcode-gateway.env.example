# Production Environment Configuration for zcode-gateway
# File permissions MUST be restricted: chmod 0600 /etc/zcode-gateway/zcode-gateway.env
# Chown: chown zcode:zcode /etc/zcode-gateway/zcode-gateway.env

# Network Binding
BIND_HOST=127.0.0.1
PORT=20131

# Mandatory for non-loopback bind or behind shared reverse proxy
# Generate with: openssl rand -hex 32
ZCODE_BRIDGE_TOKEN=

# Reverse Proxy Security
# Comma-separated list of Host header values allowed through the gateway
ZCODE_ALLOWED_HOSTS=127.0.0.1,localhost,ai.example.com

# Reverse Proxy IP / CIDR list for trusted X-Forwarded-For resolution
ZCODE_TRUSTED_PROXIES=127.0.0.1,::1

# Concurrency & Lane Scheduling (ADR 0002)
# ZCODE_LANE_WIDTH: Maximum concurrent requests across the entire gateway
ZCODE_LANE_WIDTH=2

# ZCODE_ACCOUNT_CONCURRENCY: Maximum concurrent requests per individual ZCode account
ZCODE_ACCOUNT_CONCURRENCY=1

# Rate Limiting (Token-Bucket per client IP)
ZCODE_RATE_LIMIT_RPS=20
ZCODE_RATE_LIMIT_BURST=40

# Timeouts & Limits
ZCODE_SHUTDOWN_TIMEOUT_MS=15000
ZCODE_HEADER_TIMEOUT_MS=120000
ZCODE_STREAM_IDLE_TIMEOUT_MS=120000
ZCODE_MAX_BODY_BYTES=33554432

# Storage
ZCODE_ACCOUNTS_FILE=/var/lib/zcode-gateway/accounts.json
